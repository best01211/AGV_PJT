JETANK_MODE=mock
# 모터 제어용 주소는 현재 사용하지 않습니다.
JETANK_HOST=70.12.231.81
JETANK_PORT=
JETANK_CAMERA_URL=http://70.12.231.81:8765/video
# 영상 서버를 확인한 뒤 mjpeg 또는 snapshot을 지정합니다.
JETANK_CAMERA_FORMAT=mjpeg
# 두 번째 전면 카메라를 사용할 때 별도 영상 주소와 형식을 지정합니다.
JETANK_SECONDARY_CAMERA_URL=
JETANK_SECONDARY_CAMERA_FORMAT=
# 보정 영상과 실측 초점거리를 사용하는 기본 후보. 기존 비교 모델은 depthanything.
JETANK_DEPTH_ENGINE=depthpro
